# Landing AI AIDE API key — get yours at https://app.landing.ai/
VISION_AGENT_API_KEY=your_landing_ai_key_here

# S3 document storage (Phase 3 — disabled by default)
# Set S3_STORAGE_ENABLED=true to persist uploaded documents and extracted outputs.
# Documents are stored under a per-session UUID prefix: <uuid>/input/ and <uuid>/output/
S3_STORAGE_ENABLED=false
S3_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1
# AWS credentials — omit if running on EC2/ECS/Lambda with an IAM role attached.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Phase 3 — Bedrock Knowledge Base + Strands Agent
# Copy these values from the Bedrock console after creating the KB and data source.
BEDROCK_KB_ID=your-knowledge-base-id
BEDROCK_DS_ID=your-data-source-id
# Foundation model for the Strands agent (must be enabled in Bedrock Model Access).
# Testing / no payment gate:  amazon.nova-lite-v1:0  (default)
# Demo quality:               anthropic.claude-haiku-4-5-20251001-v1:0
# Premium demo:               us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Phase 3 — Lambda: Landing AI key via Secrets Manager (recommended for prod).
# Secret value must be JSON: {"VISION_AGENT_API_KEY": "your_key"}
# Leave blank to fall back to VISION_AGENT_API_KEY above (local testing only).
LANDING_AI_SECRET_NAME=documentagent/landing-ai-key
